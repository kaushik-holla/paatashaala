# Paatashaala server configuration
# Copy to .env.local. Keep real keys out of Git. For local use you can also
# enter provider keys and choose your default model in Settings -> AI providers.

# Primary language model. Configure one provider or use the settings UI.
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-6-sol,gpt-6-luna
# DEFAULT_MODEL=openai:gpt-6-sol
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# Required to protect individual ChatGPT sign-in sessions. Generate with:
# openssl rand -hex 32
# CHATGPT_SESSION_SECRET=replace-with-a-64-character-random-hex-value

# Azure OpenAI uses your deployment name as the model ID.
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai
# AZURE_OPENAI_MODELS=YOUR-DEPLOYMENT-NAME

# Amazon Bedrock uses AWS credentials or an attached IAM role.
# BEDROCK_REGION=us-east-1
# BEDROCK_MODELS=us.anthropic.claude-sonnet-5

# Local providers need a running server and an explicit URL.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODELS=llama3.3,gemma3
# LEMONADE_BASE_URL=http://localhost:13305/v1

# Optional media providers.
IMAGE_OPENAI_API_KEY=
IMAGE_NANO_BANANA_API_KEY=
IMAGE_GROK_API_KEY=
IMAGE_OPENROUTER_API_KEY=
VIDEO_VEO_API_KEY=
VIDEO_GROK_API_KEY=
VIDEO_OPENROUTER_API_KEY=

# Optional speech and search.
TTS_OPENAI_API_KEY=
TTS_AZURE_API_KEY=
TTS_ELEVENLABS_API_KEY=
ASR_OPENAI_API_KEY=
ASR_AZURE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
WEB_SEARCH_CLAUDE_API_KEY=
# SEARXNG_BASE_URL=https://YOUR-INSTANCE.example

# Optional advanced local storage and agent workbench.
# DATABASE_URL=postgres://user:password@host:5432/paatashaala
# PERSISTENCE_DEV_TOKEN=replace-with-a-long-random-secret
# NEXT_PUBLIC_PERSISTENCE=1
# PAATASHAALA_AGENT_RUNTIME_ENABLED=true

# Local course library (default on localhost; independent of browser cookies).
# Override with an absolute path on a persistent disk. Back up this whole folder.
# PAATASHAALA_MEDIA_DIR=/path/to/Paatashaala-media
# Set browser to opt out of local disk storage. PostgreSQL mode takes precedence.
# NEXT_PUBLIC_COURSE_STORAGE=browser
